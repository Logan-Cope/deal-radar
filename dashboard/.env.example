# All optional. With none set, the app runs the demo: per-visitor sandboxes and fixture readings.

# READER=claude reads notes with the Claude API (needs ANTHROPIC_API_KEY). Shared mode only:
# the demo always reads from fixtures, because it replays a log the browser sends back.
READER=
ANTHROPIC_API_KEY=

# Shared mode: one real ledger instead of the demo. RADAR_TOKEN enables POST /api/radar/events
# (the radar sends it as LEDGER_TOKEN), and LEDGER_PASSWORD guards every page and action.
RADAR_TOKEN=
LEDGER_PASSWORD=
